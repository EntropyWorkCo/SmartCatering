{
  "expo": {
    "name": "Meydan Lokanta Ankara",
    "slug": "smartcatering",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#f59e0b",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.entropywork.smartcatering",
      "buildNumber": "5",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.entropywork.smartcatering",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Menüye yemek fotoğrafı eklemek için fotoğraflarınıza erişim izni gereklidir.",
          "cameraPermission": "Menüye yemek fotoğrafı çekmek için kameranıza erişim izni gereklidir."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#f59e0b",
          "defaultChannel": "default",
          "sounds": [],
          "mode": "development"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de0c5b9d-8af0-44b2-8441-3be30b372aa0"
      }
    },
    "owner": "entropywork"
  }
}
